# Copy this file to .env and fill in your token.
# Create at https://huggingface.co/settings/tokens/new
# (fine-grained token with "Make calls to Inference Providers")
HF_TOKEN=hf_your-token-here

# Open models via Hugging Face Inference Providers (router.huggingface.co)
# Policy suffixes on model id: :fastest :cheapest :preferred or provider e.g. :groq
HF_MODEL=Qwen/Qwen2.5-72B-Instruct:fastest
# Used when a canvas item includes an image
HF_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct:fastest
# Optional: force a specific inference provider (otherwise auto / model suffix)
# HF_PROVIDER=groq
# Llama alternative:
# HF_MODEL=meta-llama/Llama-3.3-70B-Instruct:fastest

PORT=8787
