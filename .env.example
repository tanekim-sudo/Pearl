# Canonical production model layer: Vercel AI Gateway.
# Create a key in the Vercel AI Gateway dashboard for local/self-hosted use.
# Vercel deployments receive VERCEL_OIDC_TOKEN automatically; do not copy it.
AI_GATEWAY_API_KEY=your_ai_gateway_key_here

# Optional task-profile preferences. "Auto" is the product default; these IDs
# must exist in https://ai-gateway.vercel.sh/v1/models.
# AI_GATEWAY_MODEL_MOVE=creator/model
# AI_GATEWAY_MODEL_FUNCTION=creator/model
# AI_GATEWAY_MODEL_LENS=creator/model
# AI_GATEWAY_MODEL_LENS_ENCODING=creator/vision-model
# AI_GATEWAY_MODEL_WORKSPACE_VISION=creator/vision-model
# AI_GATEWAY_MODEL_COMPANION=creator/tool-model
# AI_GATEWAY_MODEL_TRANSCRIPT=creator/model
# AI_GATEWAY_MODEL_LIGHTWEIGHT=creator/model

# Explicit compatibility fallback only. It is disabled unless both the opt-in
# and a provider credential are present.
# MODEL_GATEWAY_ALLOW_DIRECT_FALLBACK=true
# HF_TOKEN=hf_your-token-here
# HF_MODEL=Qwen/Qwen2.5-72B-Instruct:fastest

PORT=8787

# Optional: Supabase accounts & plans. Both values are safe to expose in the
# client bundle — the publishable key is an identifier, access control is RLS.
# Leave unset to run Lens without accounts (the app works exactly the same).
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Chrome/Firefox extension id for trusted web↔extension handoff and install checks.
# Required in production builds that accept Arrange-in-Scene continuation links.
# Local audits/release:check default to audit-extension-id when unset.
# VITE_LENS_EXTENSION_ID=your_chrome_extension_id

# Optional: server-side Supabase (JWT verification, subscription lookups).
# Never expose the secret key in the client or VITE_ vars.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_your-key-here
# Set to true to require sign-in for AI endpoints when the secret is configured:
# SUPABASE_REQUIRE_AUTH=true
