{
  "name": "@lens/everywhere-extension",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js && vite build --config vite.content.config.js && node scripts/platform-manifests.mjs",
    "test": "node --test tests/*.test.js",
    "package": "npm run build && node scripts/package.mjs",
    "audit": "node scripts/playwright-audit.mjs",
    "audit:pearl-dnd": "node scripts/pearl-dnd-audit.mjs"
  }
}
